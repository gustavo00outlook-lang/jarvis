# Copie para .env.local e preencha só o que for usar.
# O atalho INICIAR-JARVIS.bat sobe com Ollama local e a voz Thomas (master.wav).
# Nenhuma chave abaixo é obrigatória para esse caminho.

JARVIS_LLM_PROVIDER=ollama
JARVIS_SKIP_XAI=1
JARVIS_OLLAMA_MODEL=hermes3
JARVIS_VOICE_PRIMARY=local
JARVIS_LOCAL_CLONE_URL=http://127.0.0.1:8787
JARVIS_LOCAL_VOICE_ID=thomas-0701

# Opcionais — cada pessoa usa a própria conta. Não commite este arquivo preenchido.
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FISH_API_KEY=
